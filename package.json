{
  "name": "git-updater",
  "version": "0.1.7",
  "description": "On-demand desktop GUI that updates apps from their GitHub releases (portable & installed). Windows, macOS and Linux. Electron front-end, no localhost server, no shell.",
  "bin": {
    "git-updater": "bin/watch.js"
  },
  "main": "electron/main.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "electron .",
    "test": "node --test",
    "dist": "electron-builder --win",
    "dist:win": "electron-builder --win",
    "dist:mac": "electron-builder --mac",
    "dist:linux": "electron-builder --linux"
  },
  "license": "MIT",
  "dependencies": {
    "7z-wasm": "^1.2.0",
    "adm-zip": "^0.6.1"
  },
  "devDependencies": {
    "electron": "^44.3.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.teejs.gitupdater",
    "productName": "git-updater",
    "artifactName": "git-updater-${version}-${arch}.${ext}",
    "files": [
      "electron/**/*",
      "ui/**/*",
      "src/**/*",
      "node_modules/**/*"
    ],
    "win": {
      "signtoolOptions": {
        "sign": "./sign.js"
      },
      "target": [
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ]
    },
    "mac": {
      "artifactName": "git-updater-${version}-mac-${arch}.${ext}",
      "category": "public.app-category.utilities",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64"
          ]
        }
      ],
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "notarize": true
    },
    "linux": {
      "artifactName": "git-updater-${version}-linux-${arch}.${ext}",
      "category": "Utility",
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "tar.gz",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ]
    }
  }
}
