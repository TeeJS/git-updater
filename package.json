{
  "name": "git-updater",
  "version": "0.1.3",
  "description": "On-demand Windows GUI that updates apps from their GitHub releases (portable & installed). Electron front-end, no localhost server, no shell.",
  "bin": {
    "git-updater": "bin/watch.js"
  },
  "main": "electron/main.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "electron .",
    "test": "node --test",
    "dist": "electron-builder --win"
  },
  "license": "MIT",
  "dependencies": {
    "7z-wasm": "^1.2.0",
    "adm-zip": "^0.6.0"
  },
  "devDependencies": {
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.teejs.gitupdater",
    "productName": "git-updater",
    "artifactName": "git-updater-${version}-${arch}.${ext}",
    "files": [
      "electron/**/*",
      "ui/**/*",
      "src/**/*",
      "node_modules/**/*"
    ],
    "win": {
      "sign": "./sign.js",
      "target": [
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ]
    }
  }
}
